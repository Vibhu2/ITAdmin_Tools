{"nodes": [{"id": "dnsenrichment_design_v2", "label": "DNSEnrichment Module Design Specification v2.0 (Final)", "file_type": "document", "source_file": "VB.DNSEnrichment/Documentation/dnsenrichment-module-design-v2.md", "source_location": null, "source_url": null, "captured_at": null, "author": "VB + Claude", "contributor": null}, {"id": "dnsenrichment_sqlite_schema", "label": "DNSEnrichment SQLite Schema (Enrichment + EnrichmentHistory)", "file_type": "rationale", "source_file": "VB.DNSEnrichment/Documentation/dnsenrichment-module-design-v2.md", "source_location": "Section 9", "source_url": null, "captured_at": null, "author": "VB + Claude", "contributor": null, "rationale": "SQLite chosen over CSV/SQL Server: file-based, zero install, survives runs without licensing. Two tables: Enrichment (one row per IP, upserted) and EnrichmentHistory (append-only audit log for DHCP churn detection)."}, {"id": "dnsenrichment_coding_standards", "label": "DNSEnrichment Coding Standards (Non-Negotiable)", "file_type": "rationale", "source_file": "VB.DNSEnrichment/Documentation/dnsenrichment-module-design-v2.md", "source_location": "Section 6", "source_url": null, "captured_at": null, "author": "VB + Claude", "contributor": null, "rationale": "No aliases, no Get-WmiObject, named parameters only, no Write-Host, no silent catches, all functions return PSCustomObject, CmdletBinding required, TCP/COM in finally blocks, PS5.1 cert callback reset in finally."}, {"id": "ps51_compatibility_strategy", "label": "PS 5.1 Compatibility-First Strategy", "file_type": "rationale", "source_file": "VB.DNSEnrichment/Documentation/dnsenrichment-module-design-v2.md", "source_location": "Section 4", "source_url": null, "captured_at": null, "author": "VB + Claude", "contributor": null, "rationale": "Baseline is PS 5.1. PS7 features (ForEach-Object -Parallel, -SkipCertificateCheck) used only where meaningful and always behind context flags. Never put #Requires -Version 7 at module level."}, {"id": "skip_if_resolved_gate", "label": "Skip-If-Resolved Gate Pattern", "file_type": "rationale", "source_file": "VB.DNSEnrichment/Documentation/dnsenrichment-module-design-v2.md", "source_location": "Section 12", "source_url": null, "captured_at": null, "author": "VB + Claude", "contributor": null, "rationale": "Orchestrator tracks IsResolved. Hostname-resolving layers are skipped for IPs already resolved. Enrichment-only layers (TCP, ARP, OUI) always run. The orchestrator owns the gate \u2014 layer functions don't know they were skipped."}, {"id": "dhcp_churn_detection", "label": "DHCP Churn Detection via EnrichmentHistory", "file_type": "rationale", "source_file": "VB.DNSEnrichment/Documentation/dnsenrichment-module-design-v2.md", "source_location": "Section 18", "source_url": null, "captured_at": null, "author": "VB + Claude", "contributor": null, "rationale": "EnrichmentHistory table captures every transition of Hostname, MAC, or DeviceClass between runs. Used to detect IPs that flipped between hostnames, track a device across IPs, and identify stuck cached rows."}], "edges": [{"source": "dnsenrichment_design_v2", "target": "eleven_layer_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VB.DNSEnrichment/Documentation/dnsenrichment-module-design-v2.md", "source_location": null, "weight": 1.0}, {"source": "dnsenrichment_design_v2", "target": "enrichment_context_object", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VB.DNSEnrichment/Documentation/dnsenrichment-module-design-v2.md", "source_location": "Section 7", "weight": 1.0}, {"source": "dnsenrichment_design_v2", "target": "dnsenrichment_sqlite_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VB.DNSEnrichment/Documentation/dnsenrichment-module-design-v2.md", "source_location": "Section 9", "weight": 1.0}, {"source": "dnsenrichment_design_v2", "target": "dnsenrichment_coding_standards", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VB.DNSEnrichment/Documentation/dnsenrichment-module-design-v2.md", "source_location": "Section 6", "weight": 1.0}, {"source": "dnsenrichment_design_v2", "target": "ps51_compatibility_strategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VB.DNSEnrichment/Documentation/dnsenrichment-module-design-v2.md", "source_location": "Section 4", "weight": 1.0}, {"source": "dnsenrichment_design_v2", "target": "skip_if_resolved_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VB.DNSEnrichment/Documentation/dnsenrichment-module-design-v2.md", "source_location": "Section 12", "weight": 1.0}, {"source": "dnsenrichment_design_v2", "target": "dhcp_churn_detection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VB.DNSEnrichment/Documentation/dnsenrichment-module-design-v2.md", "source_location": "Section 18", "weight": 1.0}, {"source": "invoke_vbipenrichment", "target": "skip_if_resolved_gate", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VB.DNSEnrichment/Documentation/dnsenrichment-module-design-v2.md", "source_location": "Section 12", "weight": 1.0}, {"source": "get_vbadcomputer", "target": "enrichment_context_object", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VB.DNSEnrichment/Documentation/dnsenrichment-module-design-v2.md", "source_location": "Section 10.3", "weight": 1.0}, {"source": "get_vbdhcplease", "target": "enrichment_context_object", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VB.DNSEnrichment/Documentation/dnsenrichment-module-design-v2.md", "source_location": "Section 10.2", "weight": 1.0}, {"source": "dnsenrichment_sqlite_schema", "target": "windowsdns_sqlite_backe