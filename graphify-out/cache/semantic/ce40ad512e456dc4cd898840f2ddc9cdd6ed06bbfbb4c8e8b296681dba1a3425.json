{"nodes": [{"id": "dnsenrichment_audit_todo", "label": "VB.DNSEnrichment Developer Fix TODO (v0.4.0 to v0.5.0)", "file_type": "document", "source_file": "VB.DNSEnrichment/Documentation/vb-dnsenrichment-developer-Audit-todo.md", "source_location": null, "source_url": null, "captured_at": null, "author": "VB + Claude", "contributor": null}, {"id": "bug_c01_tcp_timeout", "label": "Bug C-01: TCP Timeout 300ms Too Short", "file_type": "rationale", "source_file": "VB.DNSEnrichment/Documentation/vb-dnsenrichment-developer-Audit-todo.md", "source_location": "C-01", "source_url": null, "captured_at": null, "author": "VB + Claude", "contributor": null, "rationale": "300ms insufficient on routed networks. Cameras, printers, VoIP phones drop out. Fix: raise to 1000ms in Get-VBTCPFingerprint.ps1 and context defaults."}, {"id": "bug_c02_sql_injection", "label": "Bug C-02: SQL Injection in SQLite Cache-Load", "file_type": "rationale", "source_file": "VB.DNSEnrichment/Documentation/vb-dnsenrichment-developer-Audit-todo.md", "source_location": "C-02", "source_url": null, "captured_at": null, "author": "VB + Claude", "contributor": null, "rationale": "IP strings interpolated directly into SQL IN clause. Fix: use named @paramN placeholders with PSSQLite parameterized query."}, {"id": "bug_c03_mdns_guard_inverted", "label": "Bug C-03: mDNS Guard Condition Logically Inverted", "file_type": "rationale", "source_file": "VB.DNSEnrichment/Documentation/vb-dnsenrichment-developer-Audit-todo.md", "source_location": "C-03", "source_url": null, "captured_at": null, "author": "VB + Claude", "contributor": null, "rationale": "Double-negated condition evaluates to wrong polarity. Runs browse when mDNS unavailable and no-context path. Fix: replace with simple positive check ($Context -and $Context.mDNSAvailable)."}, {"id": "bug_c04_parallel_cache_rebuild", "label": "Bug C-04: Parallel Runspaces Rebuild All One-Shot Caches", "file_type": "rationale", "source_file": "VB.DNSEnrichment/Documentation/vb-dnsenrichment-developer-Audit-todo.md", "source_location": "C-04", "source_url": null, "captured_at": null, "author": "VB + Claude", "contributor": null, "rationale": "Import-Module inside ForEach-Object -Parallel gives each runspace fresh script scope, nulling all script-scope caches. Fix: guard Import-Module with module-already-loaded check, pre-warm OUI table and pass via $using:."}], "edges": [{"source": "dnsenrichment_audit_todo", "target": "dnsenrichment_design_v2", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "VB.DNSEnrichment/Documentation/vb-dnsenrichment-developer-Audit-todo.md", "source_location": null, "weight": 1.0}, {"source": "dnsenrichment_audit_todo", "target": "vb_dnsenrichment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VB.DNSEnrichment/Documentation/vb-dnsenrichment-developer-Audit-todo.md", "source_location": null, "weight": 1.0}, {"source": "invoke_vbipenrichment", "target": "bug_c02_sql_injection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VB.DNSEnrichment/Documentation/vb-dnsenrichment-developer-Audit-todo.md", "source_location": "C-02", "weight": 1.0}, {"source": "invoke_vbipenrichment", "target": "bug_c04_parallel_cache_rebuild", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VB.DNSEnrichment/Documentation/vb-dnsenrichment-developer-Audit-todo.md", "source_location": "C-04", "weight": 1.0}, {"source": "get_vbtcpfingerprint", "target": "bug_c01_tcp_timeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VB.DNSEnrichment/Documentation/vb-dnsenrichment-developer-Audit-todo.md", "source_location": "C-01", "weight": 1.0}, {"source": "get_vbmdnsrecord", "target": "bug_c03_mdns_guard_inverted", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "VB.DNSEnrichment/